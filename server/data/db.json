  "snippets": [
    {
      "id": "s-01",
      "title": "React useDebounce hook",
      "language": "TypeScript",
      "code": "export function useDebounce<T>(value: T, delay = 300) {\n  const [debounced, setDebounced] = useState(value);\n  useEffect(() => {\n    const timer = setTimeout(() => setDebounced(value), delay);\n    return () => clearTimeout(timer);\n  }, [value, delay]);\n  return debounced;\n}",
      "tags": [
        "react",
        "hooks",
        "performance"
      ],
      "author": "Shwetha",
      "trending": true
    },
    {
      "id": "s-02",
      "title": "Express JWT middleware",
      "language": "JavaScript",
      "code": "const auth = (req, res, next) => {\n  const token = req.headers.authorization?.split(\" \")[1];\n  if (!token) return res.status(401).json({ error: \"Unauthorized\" });\n  try { req.user = jwt.verify(token, SECRET); next(); }\n  catch { res.status(401).json({ error: \"Invalid token\" }); }\n};",
      "tags": [
        "nodejs",
        "auth",
        "middleware"
      ],
      "author": "Rahul",
      "trending": true
    },
