{
  "name": "devcollab-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "backend": "node server/index.js",
    "dev:backend": "nodemon --watch server server/index.js",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "start": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "framer-motion": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.14.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "nodemon": "^2.0.22",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
